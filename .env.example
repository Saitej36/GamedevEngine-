# Copy to .env and fill in. Existing environment variables take precedence.

# Required for real AI agents (Claude Agent SDK). Without it the studio runs in "AI offline" mode.
ANTHROPIC_API_KEY=

# auto (default: live if credentials exist) | live | off
AI_MODE=auto
AGENT_MODEL=claude-opus-5-5

PORT=8787
# DATA_DIR=data                 # SQLite DB + project workspaces
# WORKSPACES_DIR=data/workspaces

MAX_CONCURRENT_AGENTS=2         # specialists working at the same time
MAX_TURNS_PER_TASK=40
MAX_BUDGET_USD_PER_TASK=2       # hard stop per agent run
MAX_REVISIONS=2                 # Director revision rounds before escalating to you
DIRECTOR_AUTO_REVIEW=true       # Director reviews every deliverable
AUTO_RUN_TASKS=true             # start queued tasks automatically

# Shell access for the Programmer and QA. Off by default: Bash is the one tool that can
# reach outside the workspace sandbox (a deny-list is applied, but it is best-effort).
ALLOW_AGENT_BASH=false

# Knowledge library: optional token for importing selected folders from GitHub repositories.
# GITHUB_TOKEN=
# Behind an HTTP(S) proxy, let Node's fetch use HTTPS_PROXY/NO_PROXY:
# NODE_USE_ENV_PROXY=1
