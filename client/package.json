    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^6.3.5",
    "tsx": "^4.19.4",
    "@types/node": "^22.15.0"
  }
}
